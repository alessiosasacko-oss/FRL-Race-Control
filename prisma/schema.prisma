  language              String             @default("de") @db.VarChar(16)
  dashboardLayout       Json?
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([emailEnabled])
}

model AppDataRevision {
  scope     String   @id @db.VarChar(40)
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model DesignTheme {
  id                    Int                  @id @default(autoincrement())
  name                  String               @db.VarChar(160)
  preset                DesignPreset
  defaultMode           ThemeMode            @default(DARK)
  allowDarkMode         Boolean              @default(true)
  allowLightMode        Boolean              @default(false)
  allowSystemMode       Boolean              @default(false)
  allowUserModeOverride Boolean              @default(false)
  darkTokens            Json
  lightTokens           Json
  pageAccents           Json
  componentSettings     Json
  navigationSettings    Json
  backgroundSettings    Json?
  isDraft               Boolean              @default(true)
  isActive              Boolean              @default(false)
  createdById           Int
  updatedById           Int
  publishedAt           DateTime?
  createdBy             User                 @relation("DesignThemeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                 @relation("DesignThemeUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  versions              DesignThemeVersion[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([isActive, publishedAt])
  @@index([isDraft, updatedAt])
  @@index([createdById])
  @@index([updatedById])
}

model DesignThemeVersion {
  id          Int         @id @default(autoincrement())
  themeId     Int
  version     Int
  snapshot    Json
  createdById Int
  theme       DesignTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())

  @@unique([themeId, version])
  @@index([themeId, createdAt])
  @@index([createdById])
}

model Track {
  id                    Int          @id @default(autoincrement())
  name                  String       @unique @db.VarChar(160)
  countryCode           String       @db.Char(2)
  lengthKm              Float?
  lapCount              Int?
  legacyTotalDistanceKm Float?       @map("totalDistanceKm")
  sectorCount           Int          @default(3)
  legacyDrsZones        Int?         @map("drsZones")
  legacyOvertakePoints  Int?         @map("overtakePoints")
  smStraightModeZones   Int?
  longestStraightM      Int?
  poleSide              String?      @db.VarChar(32)
  pitLaneLossSeconds    Float?
  notes                 String?      @db.Text
  active                Boolean      @default(true)
  races                 Race[]
  visual                TrackVisual?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([active, name])
  @@index([countryCode])
}

model TrackVisual {
  id                       Int      @id @default(autoincrement())
  trackId                  Int      @unique
  layoutAsset              String?  @db.Text
  layoutMimeType           String?  @db.VarChar(80)
  legacyHeroAsset          String?  @map("heroAsset") @db.Text
  legacyMobileHeroAsset    String?  @map("mobileHeroAsset") @db.Text
  legacyTrackLogoAsset     String?  @map("trackLogoAsset") @db.Text
  primaryColor             String   @default("#3B82F6") @db.Char(7)
  secondaryColor           String   @default("#22D3EE") @db.Char(7)
  overlayStrength          Int      @default(65)
  legacyImagePosition      String   @default("center") @map("imagePosition") @db.VarChar(32)
  legacyImageCrop          String   @default("cover") @map("imageCrop") @db.VarChar(32)
  lightBannerText          Boolean  @default(true)
  useThemeLayoutColor      Boolean  @default(true)
  layoutColor              String?  @db.Char(7)
  lineWidth                Int      @default(3)
  showStartFinish          Boolean  @default(true)
  showSectors              Boolean  @default(false)
  legacyShowDrsZones       Boolean  @default(false) @map("showDrsZones")
  legacyShowOvertakePoints Boolean  @default(false) @map("showOvertakePoints")
  showCornerNumbers        Boolean  @default(false)
  track                    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([primaryColor])
}

model EmailDelivery {
  id             Int                 @id @default(autoincrement())
  userId         Int
  notificationId Int?                @unique
  recipient      String              @db.VarChar(320)
  subject        String              @db.VarChar(200)
  html           String              @db.Text
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  scheduledFor   DateTime            @default(now())
  sentAt         DateTime?
  lastError      String?             @db.Text
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
}

model DiscordGuildSettings {
  id              Int                     @id @default(autoincrement())
  guildId         String                  @unique @db.VarChar(32)
  guildName       String                  @db.VarChar(160)
  enabled         Boolean                 @default(true)
  botUserId       String?                 @db.VarChar(32)
  botUsername     String?                 @db.VarChar(64)
  lastConnectedAt DateTime?
  lastHeartbeatAt DateTime?
  lastError       String?                 @db.Text
  channelMappings DiscordChannelMapping[]
  roleMappings    DiscordRoleMapping[]
  deliveries      DiscordDelivery[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([enabled])
  @@index([lastHeartbeatAt])
}

model DiscordChannelMapping {
  id              Int                   @id @default(autoincrement())
  guildSettingsId Int
  leagueId        Int?
  scopeKey        String                @db.VarChar(64)
  purpose         DiscordChannelPurpose
  channelId       String                @db.VarChar(32)
  channelName     String?               @db.VarChar(160)
  enabled         Boolean               @default(true)
  guildSettings   DiscordGuildSettings  @relation(fields: [guildSettingsId], references: [id], onDelete: Cascade)
  league          League?               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([guildSettingsId, scopeKey, purpose])
  @@index([leagueId, purpose, enabled])
  @@index([channelId])
}

model DiscordRoleMapping {
  id              Int                  @id @default(autoincrement())
  guildSettingsId Int
  role            Role
  discordRoleId   String               @db.VarChar(32)
  discordRoleName String?              @db.VarChar(160)
  enabled         Boolean              @default(true)
  guildSettings   DiscordGuildSettings @relation(fields: [guildSettingsId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([guildSettingsId, role])
  @@index([discordRoleId])
}

model DiscordDelivery {
  id               Int                   @id @default(autoincrement())
  guildSettingsId  Int
  leagueId         Int?
  announcementId   Int?
  resultGraphicId  Int?
  renderingVersion Int?
  purpose          DiscordChannelPurpose
  status           DiscordDeliveryStatus @default(PENDING)
  payload          Json
  dedupeKey        String                @unique @db.VarChar(190)
  channelId        String?               @db.VarChar(32)
  discordMessageId String?               @db.VarChar(32)
  attempts         Int                   @default(0)
  scheduledFor     DateTime              @default(now())
  sentAt           DateTime?
  lastError        String?               @db.Text
  guildSettings    DiscordGuildSettings  @relation(fields: [guildSettingsId], references: [id], onDelete: Cascade)
  league           League?               @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  announcement     Announcement?         @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  resultGraphic    ResultGraphic?        @relation(fields: [resultGraphicId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, scheduledFor])
  @@index([guildSettingsId, purpose, createdAt])
  @@index([leagueId, createdAt])
  @@index([announcementId])
  @@index([resultGraphicId, renderingVersion])
}

model Announcement {
  id                Int                  @id @default(autoincrement())
  createdByUserId   Int
  title             String               @db.VarChar(160)
  content           String               @db.Text
  href              String?              @db.VarChar(500)
  priority          NotificationPriority @default(NORMAL)
  target            AnnouncementTarget
  status            AnnouncementStatus   @default(SCHEDULED)
  pinned            Boolean              @default(false)
  scheduledFor      DateTime             @default(now())
  publishedAt       DateTime?
  lastError         String?              @db.Text
  createdBy         User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  discordDeliveries DiscordDelivery[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, scheduledFor])
  @@index([pinned, publishedAt])
  @@index([createdByUserId, createdAt])
}

model AutomationJob {
  id              Int                 @id @default(autoincrement())
  type            AutomationJobType   @unique
  name            String              @db.VarChar(160)
  status          AutomationJobStatus @default(SCHEDULED)
  enabled         Boolean             @default(true)
  intervalMinutes Int
  nextRunAt       DateTime
  lastRunAt       DateTime?
  lockedAt        DateTime?
  attempts        Int                 @default(0)
  lastError       String?             @db.Text
  lastResult      Json?
  runs            AutomationJobRun[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([enabled, status, nextRunAt])
  @@index([lockedAt])
}

model AutomationJobRun {
  id           Int                 @id @default(autoincrement())
  jobId        Int
  retryActorId Int?
  status       AutomationJobStatus @default(RUNNING)
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  result       Json?
  error        String?             @db.Text
  job          AutomationJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  retryActor   User?               @relation("AutomationRunRetryActor", fields: [retryActorId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([jobId, startedAt])
  @@index([status, startedAt])
  @@index([retryActorId])
}

model WebhookEvent {
  id          Int                @id @default(autoincrement())
  type        WebhookEventType
  source      String             @db.VarChar(80)
  status      WebhookEventStatus @default(PENDING)
  dedupeKey   String             @unique @db.VarChar(190)
  payload     Json
  attempts    Int                @default(0)
  processedAt DateTime?
  lastError   String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model SystemAuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   Int?
  metadata   Json?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}
