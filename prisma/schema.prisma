generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FIA_PRESIDENT
  STEWARD
  TEAM_PRINCIPAL
  DRIVER
}

enum DriverLineupStatus {
  PRIMARY
  SUBSTITUTE
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum EvidenceUploadStatus {
  PREPARED
  FINALIZING
  COMPLETED
  FAILED
  ORPHANED
}

enum PenaltyType {
  NO_FURTHER_ACTION
  WARNING
  REPRIMAND
  TIME_PENALTY
  PENALTY_POINTS
  GRID_PENALTY
  QUALIFYING_BAN
  RACE_BAN
  SEASON_BAN
  DRIVE_THROUGH
  STOP_AND_GO
  DISQUALIFICATION
  POINTS_DEDUCTION
}

enum DecisionOutcome {
  NO_FURTHER_INVESTIGATION
  NO_OFFENSE
  WARNING
  PENALTY
  RACING_INCIDENT
  INADMISSIBLE
  WITHDRAWN
}

enum RaceSession {
  PRACTICE
  QUALIFYING
  SPRINT
  RACE
}

enum RaceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  REGISTERED
  DECLINED
  NO_RESPONSE
}

enum AttendanceChangeSource {
  DRIVER
  TEAM_PRINCIPAL
  ADMIN
  AUTOMATION
}

enum ResultSession {
  QUALIFYING
  RACE
  SPRINT
}

enum ResultStatus {
  FINISHED
  DNF
  DNS
  DSQ
  RETIRED
}

enum ResultGapMode {
  TO_LEADER
  TO_PREVIOUS
}

enum ResultPublicationStatus {
  DRAFT
  PUBLISHED
}

enum QualifyingFormat {
  FULL
  SHORT
}

enum ResultGraphicType {
  QUALIFYING_CLASSIFICATION
  RACE_CLASSIFICATION
  DRIVER_CHAMPIONSHIP
  CONSTRUCTOR_CHAMPIONSHIP
}

enum GraphicRenderStatus {
  PENDING
  RENDERING
  COMPLETED
  FAILED
}

enum ResultPenaltySource {
  FIA
  MANUAL
}

enum ChampionshipAdjustmentTarget {
  DRIVER
  TEAM
}

enum ChampionshipAuditAction {
  ATTENDANCE_CHANGED
  RESULT_CREATED
  RESULT_UPDATED
  RESULT_DELETED
  SCORING_CHANGED
  ADJUSTMENT_CREATED
  CHAMPIONSHIP_RECALCULATED
  GLOBAL_WEEKEND_FINALIZED
  GLOBAL_WEEKEND_INVALIDATED
  GLOBAL_STANDINGS_REBUILT
}

enum GlobalWeekendStatus {
  PENDING
  FINALIZED
  INVALIDATED
}

enum NotificationType {
  SYSTEM
  RACE_REMINDER
  ATTENDANCE
  FIA_TICKET
  FIA_DECISION
  CHAMPIONSHIP
  PENALTY
  QUALIFYING_BAN
  RACE_BAN
  ATTENDANCE_OPEN
  ATTENDANCE_CLOSING_SOON
  ATTENDANCE_CLOSED
  RACE_RESULT
  CHAMPIONSHIP_UPDATED
  NEW_SEASON
  NEW_RACE
  ADMIN_ANNOUNCEMENT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

enum DiscordChannelPurpose {
  ATTENDANCE_OPENED
  ATTENDANCE_CLOSING_SOON
  ATTENDANCE_CLOSED
  RACE_WEEKEND
  SPRINT_RESULTS
  QUALIFYING_RESULTS
  RACE_RESULTS
  DRIVER_STANDINGS
  TEAM_STANDINGS
  FIA_DECISION
  PENALTY_ISSUED
  SEASON_STARTED
  SEASON_FINISHED
  ADMIN_ANNOUNCEMENT
}

enum DiscordDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum AnnouncementTarget {
  APP
  DISCORD
  EMAIL
  ALL
}

enum AnnouncementStatus {
  SCHEDULED
  PUBLISHED
  FAILED
  CANCELLED
}

enum AutomationJobType {
  ATTENDANCE_REMINDERS
  UPCOMING_RACE_REMINDERS
  CHAMPIONSHIP_VERIFICATION
  NOTIFICATION_CLEANUP
  EMAIL_QUEUE
  DISCORD_QUEUE
  MYSTERY_RACE_PUBLICATION
  STATISTICS_REFRESH
  ANNOUNCEMENT_PUBLICATION
  DISCORD_ROLE_SYNC
}

enum AutomationJobStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  DISABLED
}

enum WebhookEventType {
  RACE_FINISHED
  ATTENDANCE_CHANGED
  FIA_DECISION
  CHAMPIONSHIP_RECALCULATED
  NOTIFICATION_CREATED
  USER_UPDATED
  DISCORD_SYNCHRONIZED
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum EvidenceType {
  LINK
  IMAGE
  VIDEO
  DOCUMENT
}

enum TicketAuditAction {
  CREATED
  STATUS_CHANGED
  EVIDENCE_ADDED
  DISCUSSION_MESSAGE_ADDED
  VOTE_RECORDED
  PROPOSAL_CREATED
  PROPOSAL_VOTE_RECORDED
  PROPOSAL_CLOSED
  PROPOSAL_REVIEWED
  DECISION_PUBLISHED
  EVIDENCE_REMOVED
  ARCHIVED
  RESTORED
}

enum DiscussionMessageType {
  NORMAL
  SYSTEM
  PENALTY_PROPOSAL
}

enum PenaltyProposalStatus {
  OPEN
  CLOSED
  CANCELLED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ProposalKind {
  PENALTY
  GENERAL
}

enum ProposalVoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

enum DesignPreset {
  FRL_RACING_BLUE
  MIDNIGHT_MOTORSPORT
  RACING_RED
  CHAMPIONSHIP_GOLD
  NEON_RACE_CONTROL
  CLEAN_LIGHT
  CUSTOM
}

enum ThemeMode {
  DARK
  LIGHT
  SYSTEM
}

enum DisplayDensity {
  COMPACT
  STANDARD
  COMFORTABLE
}

model User {
  id                       Int                        @id @default(autoincrement())
  discordId                String?                    @unique @db.VarChar(32)
  discordUsername          String?                    @db.VarChar(64)
  discordGlobalName        String?                    @db.VarChar(160)
  discordGuildNickname     String?                    @db.VarChar(160)
  discordAvatarUrl         String?                    @db.Text
  discordVerifiedAt        DateTime?
  discordSyncedAt          DateTime?
  email                    String?                    @unique @db.VarChar(320)
  emailVerified            DateTime?
  displayName              String                     @db.VarChar(160)
  avatarUrl                String?                    @db.Text
  roles                    Role[]                     @default([DRIVER])
  active                   Boolean                    @default(true)
  driver                   Driver?
  reportedTickets          FiaTicket[]                @relation("TicketReporter")
  archivedTickets          FiaTicket[]                @relation("TicketArchiver")
  ticketAssignments        FiaTicketSteward[]
  submittedEvidence        Evidence[]                 @relation("EvidenceSubmitter")
  evidenceUploads          EvidenceUpload[]
  discussionMessages       DiscussionMessage[]
  discussionMentions       DiscussionMention[]
  votes                    Vote[]
  createdPenaltyProposals  PenaltyProposal[]          @relation("ProposalCreator")
  closedPenaltyProposals   PenaltyProposal[]          @relation("ProposalCloser")
  reviewedPenaltyProposals PenaltyProposal[]          @relation("ProposalReviewer")
  proposalVoteChanges      VoteChange[]               @relation("VoteChangeActor")
  decisionMemberships      DecisionSteward[]
  ticketAuditEntries       FiaTicketAuditLog[]
  principalTeams           Team[]                     @relation("TeamPrincipal")
  organizationSeasons      TeamOrganizationSeason[]   @relation("OrganizationSeasonPrincipal")
  attendanceChanges        RaceAttendance[]           @relation("AttendanceSubmitter")
  attendanceAuditEntries   AttendanceAudit[]          @relation("AttendanceAuditActor")
  championshipAdjustments  ChampionshipAdjustment[]
  championshipAudits       ChampionshipAudit[]
  publishedResultSessions  RaceResultSession[]        @relation("ResultPublisher")
  resultPenaltyChanges     ResultPenaltyApplication[] @relation("ResultPenaltyActor")
  notifications            Notification[]
  settings                 UserSettings?
  driverCharacter          DriverCharacter?
  emailDeliveries          EmailDelivery[]
  createdAnnouncements     Announcement[]
  retriedAutomationRuns    AutomationJobRun[]         @relation("AutomationRunRetryActor")
  systemAuditEntries       SystemAuditLog[]
  createdDesignThemes      DesignTheme[]              @relation("DesignThemeCreator")
  updatedDesignThemes      DesignTheme[]              @relation("DesignThemeUpdater")
  designThemeVersions      DesignThemeVersion[]
  accounts                 Account[]
  sessions                 Session[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([active])
  @@index([displayName])
}

model Account {
  id                String   @id @default(cuid())
  userId            Int
  type              String   @db.VarChar(32)
  provider          String   @db.VarChar(64)
  providerAccountId String   @db.VarChar(255)
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?  @db.VarChar(64)
  scope             String?  @db.Text
  id_token          String?  @db.Text
  session_state     String?  @db.VarChar(255)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id @db.VarChar(255)
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

model Driver {
  id                       Int                      @id @default(autoincrement())
  userId                   Int?                     @unique
  teamId                   Int?
  leagueId                 Int
  name                     String                   @db.VarChar(160)
  number                   Int
  flag                     String                   @db.VarChar(16)
  countryCode              String                   @db.Char(2)
  active                   Boolean                  @default(true)
  user                     User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  team                     Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  league                   League                   @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  standings                DriverStanding[]
  ticketLinks              FiaTicketDriver[]
  attendanceEntries        RaceAttendance[]         @relation("ExpectedAttendanceDriver")
  substituteAttendances    RaceAttendance[]         @relation("SubstituteAttendanceDriver")
  attendanceAuditEntries   AttendanceAudit[]
  raceResults              RaceResult[]             @relation("ResultDriver")
  substituteForResults     RaceResult[]             @relation("ExpectedResultDriver")
  championshipAdjustments  ChampionshipAdjustment[]
  affectedPenaltyProposals PenaltyProposal[]
  fiaDecisions             Decision[]
  seasonAssignments        DriverSeasonAssignment[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([leagueId, number])
  @@index([leagueId, active])
  @@index([teamId])
  @@index([name])
}

model DriverSeasonAssignment {
  id             Int                @id @default(autoincrement())
  driverId       Int
  seasonId       Int
  leagueId       Int
  organizationId Int?
  lineupStatus   DriverLineupStatus @default(PRIMARY)
  active         Boolean            @default(true)
  driver         Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  season         Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  league         League             @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  organization   TeamOrganization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([driverId, seasonId])
  @@index([seasonId, leagueId, organizationId, lineupStatus, active])
  @@index([organizationId, seasonId, leagueId])
}

model Team {
  id                      Int                      @id @default(autoincrement())
  leagueId                Int
  seasonId                Int
  organizationId          Int?
  principalUserId         Int?
  name                    String                   @db.VarChar(160)
  shortName               String                   @db.VarChar(12)
  color                   String                   @db.Char(7)
  secondaryColor          String?                  @db.Char(7)
  contrastColor           String?                  @db.Char(7)
  logoUrl                 String?                  @db.Text
  backgroundGradient      String?                  @db.VarChar(120)
  active                  Boolean                  @default(true)
  archivedAt              DateTime?
  systemManaged           Boolean                  @default(false)
  internalSlotKey         String?                  @unique @db.VarChar(96)
  league                  League                   @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  season                  Season                   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  principal               User?                    @relation("TeamPrincipal", fields: [principalUserId], references: [id], onDelete: SetNull)
  organization            TeamOrganization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  drivers                 Driver[]
  standings               TeamStanding[]
  attendanceEntries       RaceAttendance[]
  representedResults      RaceResult[]
  championshipAdjustments ChampionshipAdjustment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([leagueId, seasonId, active])
  @@index([archivedAt])
  @@index([principalUserId])
  @@index([organizationId, seasonId])
  @@index([organizationId, seasonId, leagueId, systemManaged])
}

model TeamOrganization {
  id                Int                      @id @default(autoincrement())
  name              String                   @db.VarChar(160)
  shortName         String                   @db.VarChar(12)
  color             String                   @db.Char(7)
  secondaryColor    String?                  @db.Char(7)
  contrastColor     String?                  @db.Char(7)
  logoUrl           String?                  @db.Text
  active            Boolean                  @default(true)
  archivedAt        DateTime?
  teams             Team[]
  seasons           TeamOrganizationSeason[]
  standings         GlobalTeamStanding[]
  contributions     GlobalTeamContribution[]
  driverAssignments DriverSeasonAssignment[]
  suitTemplates     TeamSuitTemplate[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([name])
  @@index([shortName])
  @@index([active, name])
  @@index([archivedAt])
}

model TeamOrganizationSeason {
  id              Int              @id @default(autoincrement())
  organizationId  Int
  seasonId        Int
  principalUserId Int?
  organization    TeamOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  season          Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  principal       User?            @relation("OrganizationSeasonPrincipal", fields: [principalUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, seasonId])
  @@index([seasonId, principalUserId])
  @@index([principalUserId])
}

model League {
  id                               Int                      @id @default(autoincrement())
  currentSeasonId                  Int?
  name                             String                   @db.VarChar(160)
  code                             String                   @unique @db.VarChar(12)
  description                      String?                  @db.Text
  active                           Boolean                  @default(true)
  raceWeekday                      Int                      @default(7)
  raceStartMinute                  Int                      @default(1140)
  raceTimezone                     String                   @default("Europe/Berlin") @db.VarChar(64)
  defaultAttendanceDeadlineMinutes Int?
  displayOrder                     Int                      @default(0)
  color                            String?                  @db.Char(7)
  currentSeason                    Season?                  @relation("CurrentSeason", fields: [currentSeasonId], references: [id], onDelete: SetNull)
  seasons                          Season[]                 @relation("LeagueSeasons")
  calendarSeasons                  Season[]                 @relation("SeasonParticipation")
  teams                            Team[]
  drivers                          Driver[]
  championships                    Championship[]
  scoringConfigurations            ScoringConfiguration[]
  resultSessions                   RaceResultSession[]
  championshipAdjustments          ChampionshipAdjustment[]
  championshipAudits               ChampionshipAudit[]
  globalTeamContributions          GlobalTeamContribution[]
  tickets                          FiaTicket[]
  raceSchedules                    RaceLeagueSchedule[]
  attendanceAuditEntries           AttendanceAudit[]
  driverAssignments                DriverSeasonAssignment[]
  discordChannels                  DiscordChannelMapping[]
  discordDeliveries                DiscordDelivery[]
  resultGraphics                   ResultGraphic[]
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt

  @@index([active])
  @@index([name])
  @@index([currentSeasonId])
}

model Season {
  id                      Int                      @id @default(autoincrement())
  leagueId                Int
  name                    String                   @db.VarChar(160)
  startsOn                DateTime                 @db.Date
  endsOn                  DateTime                 @db.Date
  active                  Boolean                  @default(true)
  archivedAt              DateTime?
  league                  League                   @relation("LeagueSeasons", fields: [leagueId], references: [id], onDelete: Restrict)
  participatingLeagues    League[]                 @relation("SeasonParticipation")
  currentForLeagues       League[]                 @relation("CurrentSeason")
  races                   Race[]
  teams                   Team[]
  driverAssignments       DriverSeasonAssignment[]
  championships           Championship[]
  scoringConfigurations   ScoringConfiguration[]
  championshipAdjustments ChampionshipAdjustment[]
  championshipAudits      ChampionshipAudit[]
  organizationSeasons     TeamOrganizationSeason[]
  globalTeamStandings     GlobalTeamStanding[]
  tickets                 FiaTicket[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([leagueId, name])
  @@index([leagueId, active])
  @@index([leagueId, archivedAt])
  @@index([startsOn, endsOn])
}

model Race {
  id                      Int                      @id @default(autoincrement())
  seasonId                Int
  trackId                 Int?
  name                    String                   @db.VarChar(160)
  circuit                 String?                  @db.VarChar(160)
  countryCode             String?                  @db.Char(2)
  round                   Int
  weekendDate             DateTime                 @db.Date
  scheduledAt             DateTime
  timezone                String                   @default("Europe/Berlin") @db.VarChar(64)
  status                  RaceStatus               @default(SCHEDULED)
  sessions                RaceSession[]
  sprint                  Boolean                  @default(false)
  doublePoints            Boolean                  @default(false)
  mystery                 Boolean                  @default(false)
  attendanceDeadline      DateTime?
  season                  Season                   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  track                   Track?                   @relation(fields: [trackId], references: [id], onDelete: SetNull)
  tickets                 FiaTicket[]
  attendanceEntries       RaceAttendance[]
  leagueSchedules         RaceLeagueSchedule[]
  attendanceAuditEntries  AttendanceAudit[]
  resultSessions          RaceResultSession[]
  championshipAdjustments ChampionshipAdjustment[]
  championshipAudits      ChampionshipAudit[]
  globalWeekend           GlobalRaceWeekend?
  globalTeamContributions GlobalTeamContribution[]
  resultGraphics          ResultGraphic[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([seasonId, round])
  @@unique([seasonId, name])
  @@index([seasonId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([trackId])
}

model Championship {
  id              Int              @id @default(autoincrement())
  leagueId        Int
  seasonId        Int
  name            String           @db.VarChar(160)
  league          League           @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  season          Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  driverStandings DriverStanding[]
  teamStandings   TeamStanding[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([leagueId, seasonId])
  @@index([seasonId])
  @@index([leagueId])
  @@index([name])
}

model DriverStanding {
  id               Int          @id @default(autoincrement())
  championshipId   Int
  driverId         Int
  position         Int
  points           Float        @default(0)
  racePoints       Float        @default(0)
  sprintPoints     Float        @default(0)
  bonusPoints      Float        @default(0)
  adjustments      Float        @default(0)
  wins             Int          @default(0)
  podiums          Int          @default(0)
  polePositions    Int          @default(0)
  fastestLaps      Int          @default(0)
  starts           Int          @default(0)
  dnfs             Int          @default(0)
  dsqs             Int          @default(0)
  bestResult       Int?
  substituteStarts Int          @default(0)
  tieBreak         Json         @default("{}")
  penaltyPoints    Float        @default(0)
  championship     Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  driver           Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([championshipId, driverId])
  @@unique([championshipId, position])
  @@index([driverId])
  @@index([championshipId, points])
}

model TeamStanding {
  id             Int          @id @default(autoincrement())
  championshipId Int
  teamId         Int
  position       Int
  points         Float        @default(0)
  racePoints     Float        @default(0)
  sprintPoints   Float        @default(0)
  bonusPoints    Float        @default(0)
  adjustments    Float        @default(0)
  wins           Int          @default(0)
  podiums        Int          @default(0)
  polePositions  Int          @default(0)
  fastestLaps    Int          @default(0)
  tieBreak       Json         @default("{}")
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([championshipId, teamId])
  @@unique([championshipId, position])
  @@index([teamId])
  @@index([championshipId, points])
}

model RaceAttendance {
  id                 Int                    @id @default(autoincrement())
  raceId             Int
  leagueScheduleId   Int
  driverId           Int
  substituteDriverId Int?
  representedTeamId  Int?
  submittedByUserId  Int
  status             AttendanceStatus
  changeSource       AttendanceChangeSource @default(DRIVER)
  changeReason       String?                @db.VarChar(1000)
  race               Race                   @relation(fields: [raceId], references: [id], onDelete: Restrict)
  leagueSchedule     RaceLeagueSchedule     @relation(fields: [leagueScheduleId], references: [id], onDelete: Restrict)
  driver             Driver                 @relation("ExpectedAttendanceDriver", fields: [driverId], references: [id], onDelete: Restrict)
  substituteDriver   Driver?                @relation("SubstituteAttendanceDriver", fields: [substituteDriverId], references: [id], onDelete: Restrict)
  representedTeam    Team?                  @relation(fields: [representedTeamId], references: [id], onDelete: Restrict)
  submittedBy        User                   @relation("AttendanceSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  auditEntries       AttendanceAudit[]
  changedAt          DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([raceId, driverId])
  @@unique([raceId, substituteDriverId])
  @@index([raceId, status])
  @@index([leagueScheduleId, status])
  @@index([representedTeamId, raceId])
  @@index([submittedByUserId])
}

model RaceLeagueSchedule {
  id                 Int               @id @default(autoincrement())
  raceId             Int
  leagueId           Int
  scheduledAt        DateTime
  timezone           String            @db.VarChar(64)
  attendanceDeadline DateTime?
  race               Race              @relation(fields: [raceId], references: [id], onDelete: Cascade)
  league             League            @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  attendanceEntries  RaceAttendance[]
  attendanceAudits   AttendanceAudit[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([raceId, leagueId])
  @@index([leagueId, scheduledAt])
  @@index([raceId, scheduledAt])
  @@index([attendanceDeadline])
}

model AttendanceAudit {
  id               Int                    @id @default(autoincrement())
  attendanceId     Int?
  leagueScheduleId Int
  raceId           Int
  leagueId         Int
  driverId         Int
  changedByUserId  Int?
  actorRole        Role
  source           AttendanceChangeSource
  previousStatus   AttendanceStatus
  newStatus        AttendanceStatus
  reason           String?                @db.VarChar(1000)
  attendance       RaceAttendance?        @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  leagueSchedule   RaceLeagueSchedule     @relation(fields: [leagueScheduleId], references: [id], onDelete: Restrict)
  race             Race                   @relation(fields: [raceId], references: [id], onDelete: Restrict)
  league           League                 @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  driver           Driver                 @relation(fields: [driverId], references: [id], onDelete: Restrict)
  changedBy        User?                  @relation("AttendanceAuditActor", fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())

  @@index([raceId, leagueId, createdAt])
  @@index([driverId, createdAt])
  @@index([attendanceId, createdAt])
  @@index([changedByUserId, createdAt])
  @@index([source, createdAt])
}

model RaceResultSession {
  id                 Int                     @id @default(autoincrement())
  raceId             Int
  leagueId           Int
  session            ResultSession
