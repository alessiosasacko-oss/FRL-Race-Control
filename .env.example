# Local PostgreSQL connection used by Prisma CLI commands and the database client.
DATABASE_URL="postgresql://frl:frl@localhost:5432/frl_race_control?schema=public"
# Optional direct connection used by Prisma migrations when DATABASE_URL points
# to a pooled runtime connection.
DIRECT_URL="postgresql://frl:frl@localhost:5432/frl_race_control?schema=public"

# Auth.js: generate a real secret with `npm exec auth secret`.
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_DISCORD_ID="replace-with-discord-application-id"
AUTH_DISCORD_SECRET="replace-with-discord-client-secret"

# Private Supabase Storage for FIA video evidence. The service-role key is
# server-only and must never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="fia-evidence"
# Public bucket for sanitized track layouts and race-weekend branding assets.
SUPABASE_BRANDING_BUCKET="frl-branding"
# Public bucket for sanitized TeamOrganization logos.
SUPABASE_TEAM_LOGO_BUCKET="team-logos"
# Public bucket for deterministic result and championship PNG files.
SUPABASE_RESULT_GRAPHICS_BUCKET="result-graphics"
FIA_EVIDENCE_MAX_FILE_SIZE_MB="100"
FIA_EVIDENCE_MAX_FILES="3"
FIA_EVIDENCE_ALLOWED_MIME_TYPES="video/mp4,video/quicktime,video/webm"
FIA_EVIDENCE_SIGNED_URL_TTL_SECONDS="300"

# Discord bot credentials. Enable the Server Members Intent in the Developer Portal.
DISCORD_BOT_TOKEN="replace-with-discord-bot-token"
DISCORD_GUILD_ID="replace-with-frl-discord-server-id"

# Shared secret for /api/internal/* automation, webhook, status and sync routes.
INTERNAL_API_SECRET="replace-with-a-random-internal-api-secret"

# Optional SMTP delivery for queued notification emails.
SMTP_URL="smtp://username:password@smtp.example.com:587"
EMAIL_FROM="FRL Race Control <race-control@example.com>"

# Secret used by the scheduled POST /api/notifications/email request.
EMAIL_CRON_SECRET="replace-with-a-random-cron-secret"

# Stable key shared by all application instances for encrypted Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
# Public Mobile API v1 (comma-separated browser development origins)
MOBILE_API_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"
MOBILE_API_MIN_APP_VERSION="1.0.0"
MOBILE_API_MAINTENANCE_MODE="false"
MOBILE_API_MAINTENANCE_MESSAGE=""
